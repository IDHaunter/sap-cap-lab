{
  "authenticationMethod": "route",
  "welcomeFile": "/bookslist/index.html",
  "routes": [
    {
      "source": "^/odata/(.*)$",
      "target": "/odata/$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "csrfProtection": true
    },
    {
      "source": "^/bookslist/(.*)$",
      "target": "$1",
      "service": "html5-apps-repo-rt",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/authorslist/(.*)$",
      "target": "$1",
      "service": "html5-apps-repo-rt",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/rag/(.*)$",
      "target": "/$1",
      "destination": "rag-api",
      "authenticationType": "xsuaa"
    }
  ]
}
